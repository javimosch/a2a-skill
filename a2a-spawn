#!/usr/bin/env bash
# a2a-spawn — CLI-agnostic launcher for an a2a peer agent.
#
# Knows how to invoke claude, opencode, pi, tau, or debri non-interactively with a kit
# prompt. Hides the per-CLI flag differences:
#
#   - claude   : --append-system-prompt "$KIT"     -p "Begin."
#   - opencode : (kit embedded in message body)    run "$KIT\n\nBegin."
#   - pi       : --append-system-prompt "$KIT"     -p "Begin."
#   - tau      : --append-system-prompt "$KIT"     -p "Begin."
#   - debri    : debri-a2a agent (wraps Go debri CLI)
#
# Usage:
#   a2a-spawn --cli claude   --id alice  [--model haiku]   [--log FILE]   --kit-file FILE
#   a2a-spawn --cli opencode --id bob    [--model anthropic/claude-haiku-4-5] --kit-file FILE
#   a2a-spawn --cli pi       --id carol  [--provider google] [--model …]   --kit-file FILE
#   a2a-spawn --cli tau      --id dave  [--provider xiaomi] [--model …]   --kit-file FILE
#   a2a-spawn --cli debri    --id eve   [--model SWE-1.6]   [--log FILE]   --kit-file FILE
#
# Writes the spawned PID to stdout. Send SIGTERM to that PID to stop the agent.
# Reads the kit prompt from --kit-file (recommended; avoids shell-escape bugs).
set -u

CLI=""
ID=""
MODEL=""
PROVIDER=""
PROJECT=""
LOG=""
KIT_FILE=""
usage() {
    cat <<EOF
a2a-spawn — CLI-agnostic launcher for an a2a peer agent.

Usage:
  a2a-spawn --cli claude|opencode|pi|tau|debri --id NAME [options]

Required:
  --cli TYPE     Agentic CLI to launch (claude, opencode, pi, tau, debri)
  --id NAME      Agent identifier on the a2a bus
  --kit-file FILE  Path to the kit prompt file

Options:
  --model NAME   Model to use (e.g. haiku, anthropic/claude-haiku-4-5, SWE-1.6)
  --provider     Provider for pi/tau CLI (e.g. google, openai, xiaomi)
  --project NAME Set A2A_PROJECT for the spawned agent (default: basename($PWD))
  --log FILE     Log file (default: /tmp/a2a-<id>.log)

Outputs the spawned PID to stdout.
EOF
    exit 0
}

EXTRA_ARGS=()

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) usage;;
        --cli)        CLI="$2";        shift 2;;
        --id)         ID="$2";         shift 2;;
        --model)      MODEL="$2";        shift 2;;
        --provider)   PROVIDER="$2";   shift 2;;
        --project)    PROJECT="$2";    shift 2;;
        --log)        LOG="$2";        shift 2;;
        --kit-file)   KIT_FILE="$2";   shift 2;;
        --)           shift; EXTRA_ARGS+=("$@"); break;;
        *)            echo "a2a-spawn: unknown arg $1" >&2; exit 2;;
    esac
done

[ -z "$CLI" ]      && { echo "a2a-spawn: --cli required (claude|opencode|pi|tau|debri)" >&2; exit 2; }
[ -z "$ID" ]       && { echo "a2a-spawn: --id required" >&2; exit 2; }
[ -z "$KIT_FILE" ] && { echo "a2a-spawn: --kit-file required" >&2; exit 2; }
[ -r "$KIT_FILE" ] || { echo "a2a-spawn: cannot read kit file $KIT_FILE" >&2; exit 2; }

if [ -z "$LOG" ]; then
    LOG="/tmp/a2a-$ID.log"
fi
KIT="$(cat "$KIT_FILE")"

# Resolve opencode (the user's `opencode` alias goes through tmux which needs
# a real terminal). Fall back to the real binary if present.
resolve_opencode() {
    if [ -x "$HOME/.opencode/bin/opencode" ]; then
        echo "$HOME/.opencode/bin/opencode"
    elif command -v opencode-bin >/dev/null 2>&1; then
        command -v opencode-bin
    else
        # last resort: use whatever `opencode` resolves to
        command -v opencode 2>/dev/null || echo "opencode"
    fi
}

# Use nohup + disown so the spawned process survives the parent shell exit.
_spawn_bg() {
    # "$@" is the command to run; stdout/stderr already redirected. stdin is
    # /dev/null so non-interactive CLIs (e.g. claude --output-format stream-json)
    # don't wait on stdin.
    # Use inline env var so the export is scoped only to the spawned process.
    if [ -n "$PROJECT" ]; then
        A2A_PROJECT="$PROJECT" nohup "$@" > "$LOG" 2>&1 < /dev/null &
    else
        nohup "$@" > "$LOG" 2>&1 < /dev/null &
    fi
    local PID=$!
    disown "$PID" 2>/dev/null || true
    echo "$PID"
}

case "$CLI" in
    claude)
        FLAGS=(--max-turns 50)
        # Strip the panel's "claude:" CLI prefix — claude wants a bare alias
        # ("haiku"/"sonnet") or full model id, not "claude:haiku" (which it
        # rejects as a non-existent model and exits immediately).
        CLAUDE_MODEL="${MODEL#claude:}"
        [ -n "$CLAUDE_MODEL" ] && FLAGS+=(--model "$CLAUDE_MODEL")
        # Bypass permission prompts so the agent can run a2a/bash non-interactively.
        # NOTE: --allow-dangerously-skip-permissions does NOT bypass approval for
        # non-trivial commands (the agent ends up asking for approval that nobody
        # answers in -p mode, then does nothing). The working flag is
        # --dangerously-skip-permissions. claude blocks that flag as root, so root
        # falls back to --permission-mode bypassPermissions (a valid mode; the old
        # "auto" value was invalid and silently left prompts enabled).
        # --dangerously-skip-permissions is the only flag that actually bypasses
        # approval in -p mode. claude REFUSES it (and --permission-mode
        # bypassPermissions too) when running as root/sudo — unless it believes it
        # is sandboxed. IS_SANDBOX=1 unlocks the flag for root/sudo. For non-root,
        # the flag works as-is.
        FLAGS+=(--dangerously-skip-permissions)
        # Export (not an inline VAR=val prefix): the prefix form only works with a
        # literal token, while an expanded "${arr[@]}" is parsed as a command name
        # ("IS_SANDBOX=1: command not found"). a2a-spawn exits right after
        # backgrounding claude, so exporting here just seeds the child's env.
        if [ "$(id -u)" -eq 0 ] || [ -n "${SUDO_UID:-}" ]; then
            export IS_SANDBOX=1
        else
            export CLAUDE_CODE_DANGEROUSLY_SKIP_PERMISSIONS=1
        fi
        # Pass the kit CONTENT (not the file path): claude is launched in the
        # background, and the caller often deletes the kit file immediately after
        # spawn — --append-system-prompt-file then fails with "file not found" and
        # claude exits in ~1s doing nothing. $KIT already holds the file content.
        # --output-format stream-json --verbose: emit structured events (every
        # tool call + result) so the worker can summarize what the agent actually
        # did into the run log (visibility for debugging stalls/no-op runs).
        _spawn_bg "$HOME/.local/bin/claude" \
            -p "Begin." \
            "${FLAGS[@]}" \
            --output-format stream-json --verbose \
            --append-system-prompt "$KIT"
        ;;
    opencode)
        OPENCODE="$(resolve_opencode)"
        FLAGS=(run --dangerously-skip-permissions)
        [ -n "$MODEL" ] && FLAGS+=(-m "$MODEL")
        # opencode has no --append-system-prompt; embed kit in the message.
        # We pass everything as one positional argument so shell quoting is safe.
        MSG="$KIT

---
Begin."
        _spawn_bg "$OPENCODE" "${FLAGS[@]}" "$MSG"
        ;;
    pi)
        FLAGS=(-p)
        [ -n "$MODEL" ]    && FLAGS+=(--model "$MODEL")
        [ -n "$PROVIDER" ] && FLAGS+=(--provider "$PROVIDER")
        _spawn_bg pi "${FLAGS[@]}" \
            --append-system-prompt "$KIT" \
            "Begin."
        ;;
    tau)
        # Resolve tau binary: TAU_BIN env var > local build > project build > PATH
        if [ -n "${TAU_BIN:-}" ] && [ -x "$TAU_BIN" ]; then
            :  # use TAU_BIN as-is
        elif [ -x "./zig-out/bin/tau" ]; then
            TAU_BIN="./zig-out/bin/tau"
        elif [ -x "$HOME/ai/tau/zig-out/bin/tau" ]; then
            TAU_BIN="$HOME/ai/tau/zig-out/bin/tau"
        elif command -v tau >/dev/null 2>&1; then
            TAU_BIN="tau"
        else
            echo "a2a-spawn: tau binary not found (set TAU_BIN, or ./zig-out/bin/tau, ~/ai/tau/zig-out/bin/tau, or tau in PATH)" >&2
            exit 2
        fi
        # --max-iterations raised: multi-exchange a2a coordination needs many
        # send/recv tool turns (the default 10 stalls long debates).
        # --timeout-ms raised: reasoning models are slow generating large outputs
        # (e.g. code files) over a big context; the 120s default times out.
        # --tools defaults to bash; override with TAU_TOOLS for richer agents.
        # TAU_THINKING=1 enables --thinking (show reasoning chunks) for debugging.
        # TAU_DEBUG=1 enables --debug (perf stats + tool I/O to stderr) for troubleshooting.
        FLAGS=(-p --no-stream --tools "${TAU_TOOLS:-bash}" --max-iterations 40 --timeout-ms 300000)
        [ "${TAU_THINKING:-0}" = "1" ] && FLAGS+=(--thinking)
        [ "${TAU_DEBUG:-0}" = "1" ]    && FLAGS+=(--debug)
        [ -n "$MODEL" ]    && FLAGS+=(--model "$MODEL")
        [ -n "$PROVIDER" ] && FLAGS+=(--provider "$PROVIDER")
        _spawn_bg "$TAU_BIN" "${FLAGS[@]}" \
            --append-system-prompt "$KIT" \
            "Begin."
        ;;
    debri)
        # Resolve debri (check ~/ai/debri build, then PATH)
        if [ -x "$HOME/ai/debri/debri" ]; then
            DEBRI_BIN="$HOME/ai/debri/debri"
        elif command -v debri >/dev/null 2>&1; then
            DEBRI_BIN="debri"
        else
            echo "a2a-spawn: debri not found (expected ~/ai/debri/debri or debri in PATH)" >&2
            exit 2
        fi
        # Go debri CLI flags: --model, --permission-mode, --working-dir, --stream, --json, --file, --stable-timeout
        FLAGS=(--permission-mode dangerous --stable-timeout 8000)
        [ -n "$MODEL" ]    && FLAGS+=(--model "$MODEL")
        [ -n "$PROJECT" ] && FLAGS+=(--working-dir "$PROJECT")
        # Embed kit in the prompt (debri doesn't have --append-system-prompt)
        MSG="$KIT"
        _spawn_bg "$DEBRI_BIN" "${FLAGS[@]}" "$MSG"
        ;;
    *)
        echo "a2a-spawn: unknown CLI '$CLI' (expected claude|opencode|pi|tau|debri)" >&2
        exit 2
        ;;
esac
