#!/usr/bin/env bash
# a2a-spawn — CLI-agnostic launcher for an a2a peer agent.
#
# Knows how to invoke claude, opencode, pi, tau, debri, or cursor non-interactively
# with a kit prompt. Hides the per-CLI flag differences:
#
#   - claude   : --append-system-prompt "$KIT"     -p "Begin."
#   - opencode : (kit embedded in message body)    run "$KIT\n\nBegin."
#   - pi       : --append-system-prompt "$KIT"     -p "Begin."
#   - tau      : --append-system-prompt "$KIT"     -p "Begin."
#   - debri    : Go debri binary (wraps local devin CLI via tmux)
#   - cursor   : official Cursor Agent CLI (agent / cursor-agent), headless -p
#
# Usage:
#   a2a-spawn --cli claude   --id alice  [--model haiku]   [--log FILE]   --kit-file FILE
#   a2a-spawn --cli opencode --id bob    [--model anthropic/claude-haiku-4-5] --kit-file FILE
#   a2a-spawn --cli pi       --id carol  [--provider google] [--model …]   --kit-file FILE
#   a2a-spawn --cli tau      --id dave  [--provider xiaomi] [--model …]   --kit-file FILE
#   a2a-spawn --cli debri    --id eve   [--model SWE-1.6]   [--log FILE]   --kit-file FILE
#   a2a-spawn --cli cursor   --id frank [--model sonnet-4]  [--log FILE]   --kit-file FILE
#
# Writes the spawned PID to stdout. Send SIGTERM to that PID to stop the agent.
# Reads the kit prompt from --kit-file (recommended; avoids shell-escape bugs).
set -u

CLI=""
ID=""
MODEL=""
PROVIDER=""
PROJECT=""
LOG=""
KIT_FILE=""
usage() {
    cat <<EOF
a2a-spawn — CLI-agnostic launcher for an a2a peer agent.

Usage:
  a2a-spawn --cli claude|opencode|pi|tau|debri|cursor --id NAME [options]

Required:
  --cli TYPE     Agentic CLI (claude, opencode, pi, tau, debri, cursor)
                 Aliases for cursor: agent, cursor-agent
  --id NAME      Agent identifier on the a2a bus
  --kit-file FILE  Path to the kit prompt file

Options:
  --model NAME   Model to use (e.g. haiku, anthropic/claude-haiku-4-5, SWE-1.6)
  --provider     Provider for pi/tau CLI (e.g. google, openai, xiaomi)
  --project NAME Set A2A_PROJECT for the spawned agent (default: basename($PWD))
  --log FILE     Log file (default: /tmp/a2a-<id>.log)

Outputs the spawned PID to stdout.
EOF
    exit 0
}

EXTRA_ARGS=()

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) usage;;
        --cli)        CLI="$2";        shift 2;;
        --id)         ID="$2";         shift 2;;
        --model)      MODEL="$2";        shift 2;;
        --provider)   PROVIDER="$2";   shift 2;;
        --project)    PROJECT="$2";    shift 2;;
        --log)        LOG="$2";        shift 2;;
        --kit-file)   KIT_FILE="$2";   shift 2;;
        --)           shift; EXTRA_ARGS+=("$@"); break;;
        *)            echo "a2a-spawn: unknown arg $1" >&2; exit 2;;
    esac
done

[ -z "$CLI" ]      && { echo "a2a-spawn: --cli required (claude|opencode|pi|tau|debri|cursor)" >&2; exit 2; }
[ -z "$ID" ]       && { echo "a2a-spawn: --id required" >&2; exit 2; }
[ -z "$KIT_FILE" ] && { echo "a2a-spawn: --kit-file required" >&2; exit 2; }
[ -r "$KIT_FILE" ] || { echo "a2a-spawn: cannot read kit file $KIT_FILE" >&2; exit 2; }

if [ -z "$LOG" ]; then
    LOG="/tmp/a2a-$ID.log"
fi
KIT="$(cat "$KIT_FILE")"

# Resolve opencode (the user's `opencode` alias goes through tmux which needs
# a real terminal). Fall back to the real binary if present.
resolve_opencode() {
    if [ -x "$HOME/.opencode/bin/opencode" ]; then
        echo "$HOME/.opencode/bin/opencode"
    elif command -v opencode-bin >/dev/null 2>&1; then
        command -v opencode-bin
    else
        # last resort: use whatever `opencode` resolves to
        command -v opencode 2>/dev/null || echo "opencode"
    fi
}

# Use nohup + disown so the spawned process survives the parent shell exit.
_spawn_bg() {
    # "$@" is the command to run; stdout/stderr already redirected. stdin is
    # /dev/null so non-interactive CLIs (e.g. claude --output-format stream-json)
    # don't wait on stdin.
    # Use inline env var so the export is scoped only to the spawned process.
    if [ -n "$PROJECT" ]; then
        A2A_PROJECT="$PROJECT" nohup "$@" > "$LOG" 2>&1 < /dev/null &
    else
        nohup "$@" > "$LOG" 2>&1 < /dev/null &
    fi
    local PID=$!
    disown "$PID" 2>/dev/null || true
    echo "$PID"
}

case "$CLI" in
    claude)
        FLAGS=(--max-turns 50)
        # Strip the panel's "claude:" CLI prefix — claude wants a bare alias
        # ("haiku"/"sonnet") or full model id, not "claude:haiku" (which it
        # rejects as a non-existent model and exits immediately).
        CLAUDE_MODEL="${MODEL#claude:}"
        [ -n "$CLAUDE_MODEL" ] && FLAGS+=(--model "$CLAUDE_MODEL")
        # Bypass permission prompts so the agent can run a2a/bash non-interactively.
        # NOTE: --allow-dangerously-skip-permissions does NOT bypass approval for
        # non-trivial commands (the agent ends up asking for approval that nobody
        # answers in -p mode, then does nothing). The working flag is
        # --dangerously-skip-permissions. claude blocks that flag as root, so root
        # falls back to --permission-mode bypassPermissions (a valid mode; the old
        # "auto" value was invalid and silently left prompts enabled).
        # --dangerously-skip-permissions is the only flag that actually bypasses
        # approval in -p mode. claude REFUSES it (and --permission-mode
        # bypassPermissions too) when running as root/sudo — unless it believes it
        # is sandboxed. IS_SANDBOX=1 unlocks the flag for root/sudo. For non-root,
        # the flag works as-is.
        FLAGS+=(--dangerously-skip-permissions)
        # Export (not an inline VAR=val prefix): the prefix form only works with a
        # literal token, while an expanded "${arr[@]}" is parsed as a command name
        # ("IS_SANDBOX=1: command not found"). a2a-spawn exits right after
        # backgrounding claude, so exporting here just seeds the child's env.
        if [ "$(id -u)" -eq 0 ] || [ -n "${SUDO_UID:-}" ]; then
            export IS_SANDBOX=1
        else
            export CLAUDE_CODE_DANGEROUSLY_SKIP_PERMISSIONS=1
        fi
        # Pass the kit CONTENT (not the file path): claude is launched in the
        # background, and the caller often deletes the kit file immediately after
        # spawn — --append-system-prompt-file then fails with "file not found" and
        # claude exits in ~1s doing nothing. $KIT already holds the file content.
        # --output-format stream-json --verbose: emit structured events (every
        # tool call + result) so the worker can summarize what the agent actually
        # did into the run log (visibility for debugging stalls/no-op runs).
        _spawn_bg "$HOME/.local/bin/claude" \
            -p "Begin." \
            "${FLAGS[@]}" \
            --output-format stream-json --verbose \
            --append-system-prompt "$KIT"
        ;;
    opencode)
        OPENCODE="$(resolve_opencode)"
        FLAGS=(run --dangerously-skip-permissions)
        [ -n "$MODEL" ] && FLAGS+=(-m "$MODEL")
        # opencode has no --append-system-prompt; embed kit in the message.
        # We pass everything as one positional argument so shell quoting is safe.
        MSG="$KIT

---
Begin."
        _spawn_bg "$OPENCODE" "${FLAGS[@]}" "$MSG"
        ;;
    pi)
        FLAGS=(-p)
        [ -n "$MODEL" ]    && FLAGS+=(--model "$MODEL")
        [ -n "$PROVIDER" ] && FLAGS+=(--provider "$PROVIDER")
        _spawn_bg pi "${FLAGS[@]}" \
            --append-system-prompt "$KIT" \
            "Begin."
        ;;
    tau)
        # Resolve tau binary: TAU_BIN env var > local build > project build > PATH
        if [ -n "${TAU_BIN:-}" ] && [ -x "$TAU_BIN" ]; then
            :  # use TAU_BIN as-is
        elif [ -x "./zig-out/bin/tau" ]; then
            TAU_BIN="./zig-out/bin/tau"
        elif [ -x "$HOME/ai/tau/zig-out/bin/tau" ]; then
            TAU_BIN="$HOME/ai/tau/zig-out/bin/tau"
        elif command -v tau >/dev/null 2>&1; then
            TAU_BIN="tau"
        else
            echo "a2a-spawn: tau binary not found (set TAU_BIN, or ./zig-out/bin/tau, ~/ai/tau/zig-out/bin/tau, or tau in PATH)" >&2
            exit 2
        fi
        # --max-iterations raised: multi-exchange a2a coordination needs many
        # send/recv tool turns (the default 10 stalls long debates).
        # --timeout-ms raised: reasoning models are slow generating large outputs
        # (e.g. code files) over a big context; the 120s default times out.
        # --tools defaults to bash; override with TAU_TOOLS for richer agents.
        # TAU_THINKING=1 enables --thinking (show reasoning chunks) for debugging.
        # TAU_DEBUG=1 enables --debug (perf stats + tool I/O to stderr) for troubleshooting.
        FLAGS=(-p --no-stream --tools "${TAU_TOOLS:-bash}" --max-iterations 40 --timeout-ms 300000)
        [ "${TAU_THINKING:-0}" = "1" ] && FLAGS+=(--thinking)
        [ "${TAU_DEBUG:-0}" = "1" ]    && FLAGS+=(--debug)
        [ -n "$MODEL" ]    && FLAGS+=(--model "$MODEL")
        [ -n "$PROVIDER" ] && FLAGS+=(--provider "$PROVIDER")
        _spawn_bg "$TAU_BIN" "${FLAGS[@]}" \
            --append-system-prompt "$KIT" \
            "Begin."
        ;;
    debri)
        # Resolve debri binary: DEBRI_BIN env var (for envs like a dedicated test
        # host where debri isn't cloned to ~/ai/debri, e.g. CI or rbm21) > local
        # checkout > PATH. Mirrors the TAU_BIN override pattern below.
        if [ -n "${DEBRI_BIN:-}" ] && [ -x "$DEBRI_BIN" ]; then
            :  # use DEBRI_BIN as-is
        elif [ -x "$HOME/ai/debri/debri" ]; then
            DEBRI_BIN="$HOME/ai/debri/debri"
        elif command -v debri >/dev/null 2>&1; then
            DEBRI_BIN="debri"
        else
            echo "a2a-spawn: debri not found (set DEBRI_BIN, or ~/ai/debri/debri, or debri in PATH)" >&2
            exit 2
        fi
        # Pass the kit content as a positional argument (NOT --file) so the kit is
        # already in memory when debri starts. Using --file would reference the temp
        # path that team_spawning.go deletes via defer before debri reads it.
        #
        # Devin executes each bash tool call in a fresh shell, so shell variables
        # like $A2A don't persist across calls. Replace $A2A with the real resolved
        # path so every a2a command in the kit is self-contained.
        A2A_REAL=$(command -v a2a 2>/dev/null || echo "$HOME/.local/bin/a2a")
        # Devin runs each bash tool call in a fresh shell — env vars don't persist.
        # Inline A2A_PROJECT with every a2a invocation so commands are self-contained.
        A2A_WITH_PROJECT="A2A_PROJECT=${PROJECT:-$(basename "$PWD")} $A2A_REAL"
        DEBRI_KIT="${KIT//\$A2A/$A2A_WITH_PROJECT}"
        # Completion signal. Newer debri detects devin's process exit directly
        # (devin runs one prompt then hands the pane back to the shell), so it no
        # longer relies on the silence timer to tell "blocked on `a2a recv
        # --wait`" from "finished" — that is the primary, model-independent exit.
        # We ALSO pass a --done-marker as a belt-and-suspenders fast path (and for
        # older debri / any interactive mode where devin doesn't exit): the agent
        # prints a sentinel as its final act and debri stops the instant it
        # appears. Append the instruction to the kit and pass the matching flag.
        DEBRI_DONE_MARKER='<<DEBRI_DONE>>'
        DEBRI_KIT="$DEBRI_KIT

== Debri completion signal (REQUIRED, do this last) ==
When you are completely finished AND have run \`a2a status done\`, your very last
action must be to run this exact bash command so the harness knows to stop:
  echo '$DEBRI_DONE_MARKER'
Print it on its own line, only once, and only when truly done — not before."
        # stable-timeout stays only as a final SAFETY CAP (10 min) for the rare
        # case where neither process-exit nor the marker fires. It is no longer
        # the normal exit path.
        FLAGS=(--permission-mode=dangerous --stable-timeout=600000 --done-marker="$DEBRI_DONE_MARKER" --stream)
        [ -n "$MODEL" ] && FLAGS+=(--model="$MODEL")
        if [ -n "$PROJECT" ]; then
            A2A_PROJECT="$PROJECT" _spawn_bg "$DEBRI_BIN" "${FLAGS[@]}" "$DEBRI_KIT"
        else
            _spawn_bg "$DEBRI_BIN" "${FLAGS[@]}" "$DEBRI_KIT"
        fi
        ;;
    cursor|agent|cursor-agent)
        # Official Cursor Agent CLI — already headless-friendly (no tmux wrapper
        # like debri→devin). Resolve: CURSOR_AGENT_BIN > ~/.local/bin/agent >
        # ~/.local/bin/cursor-agent > agent/cursor-agent on PATH.
        if [ -n "${CURSOR_AGENT_BIN:-}" ] && [ -x "$CURSOR_AGENT_BIN" ]; then
            :  # use CURSOR_AGENT_BIN as-is
        elif [ -x "$HOME/.local/bin/agent" ]; then
            CURSOR_AGENT_BIN="$HOME/.local/bin/agent"
        elif [ -x "$HOME/.local/bin/cursor-agent" ]; then
            CURSOR_AGENT_BIN="$HOME/.local/bin/cursor-agent"
        elif command -v agent >/dev/null 2>&1; then
            CURSOR_AGENT_BIN="agent"
        elif command -v cursor-agent >/dev/null 2>&1; then
            CURSOR_AGENT_BIN="cursor-agent"
        else
            echo "a2a-spawn: cursor agent not found (set CURSOR_AGENT_BIN, or install agent/cursor-agent on PATH)" >&2
            exit 2
        fi
        # Load server/automation credentials if present. Prefer CURSOR_API_KEY
        # from ~/.config/cursor/env (mode 600); browser login tokens live in
        # ~/.config/cursor/auth.json and are picked up by the agent binary.
        # Override path with CURSOR_ENV_FILE. See skill rbm21-cursor.
        CURSOR_ENV_FILE="${CURSOR_ENV_FILE:-$HOME/.config/cursor/env}"
        if [ -f "$CURSOR_ENV_FILE" ]; then
            set -a
            # shellcheck disable=SC1090
            . "$CURSOR_ENV_FILE"
            set +a
        fi
        # Kits often use $A2A; inline A2A_PROJECT + resolved path so bash tool
        # calls are self-contained even if the child shell drops env.
        A2A_REAL=$(command -v a2a 2>/dev/null || echo "$HOME/.local/bin/a2a")
        A2A_WITH_PROJECT="A2A_PROJECT=${PROJECT:-$(basename "$PWD")} $A2A_REAL"
        CURSOR_KIT="${KIT//\$A2A/$A2A_WITH_PROJECT}"
        MSG="$CURSOR_KIT

---
Begin."
        # -p/--print: non-interactive (script/automation)
        # --trust: skip workspace trust prompt in headless mode
        # --force: auto-approve shell/tools so a2a bus ops are not blocked
        # --approve-mcps: avoid MCP approval stalls in background
        # --sandbox disabled: a2a needs real filesystem + network for the bus
        # --output-format stream-json: structured log for debugging stalls
        FLAGS=(-p --trust --force --approve-mcps --sandbox disabled --output-format stream-json)
        [ -n "$MODEL" ] && FLAGS+=(--model "$MODEL")
        if [ -n "${CURSOR_WORKSPACE:-}" ]; then
            FLAGS+=(--workspace "$CURSOR_WORKSPACE")
        fi
        # Propagate API key into the nohup child when set (auth.json still works
        # without this — key is preferred for headless/server hosts).
        if [ -n "${CURSOR_API_KEY:-}" ]; then
            CURSOR_API_KEY="$CURSOR_API_KEY" _spawn_bg "$CURSOR_AGENT_BIN" "${FLAGS[@]}" "$MSG"
        else
            _spawn_bg "$CURSOR_AGENT_BIN" "${FLAGS[@]}" "$MSG"
        fi
        ;;
    *)
        echo "a2a-spawn: unknown CLI '$CLI' (expected claude|opencode|pi|tau|debri|cursor)" >&2
        exit 2
        ;;
esac
